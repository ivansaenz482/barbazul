# Copia este archivo como ".env" y coloca tus datos reales.
# IMPORTANTE: el archivo ".env" nunca debe subirse a git (ya está en .gitignore)

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=coloca_aqui_tu_password_de_mysql
DB_NAME=sistema_inventario_huang

# Puerto del servidor web (5010 para no chocar con la otra copia del sistema)
PORT=5010

SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
FLASK_ENV=development

# Ruta al ejecutable de Tesseract OCR (solo si Windows no lo detecta automaticamente)
# Ejemplo tipico en Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Correo de alertas (OPCIONAL) ---
# Si dejas esto vacio, el sistema funciona igual, solo no envia correos.
# Con Gmail: activa la verificacion en 2 pasos y genera una "contraseña de aplicacion"
# en https://myaccount.google.com/apppasswords (NO uses tu contraseña normal de Gmail).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- Respaldo de base de datos (OPCIONAL) ---
# Ruta a mysqldump.exe, SOLO si Windows no lo encuentra automaticamente.
# Ejemplo tipico: C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
MYSQLDUMP_PATH=
# Cuantos respaldos guardar como maximo (los mas viejos se borran solos)
MAX_BACKUPS=30
