# ============================================================
#  Variables de entorno para PRODUCCION (nube / servidor)
#  Copia estos valores en el panel de tu hosting (Railway, Render...)
#  o en un archivo .env del servidor. NO subas este archivo con
#  valores reales a un repositorio publico.
# ============================================================

# --- Base de datos ---
# Opcion 1: una sola URL (Railway/Render/Aiven la entregan asi)
DATABASE_URL=mysql://usuario:contraseña@host:3306/base_de_datos

# Opcion 2 (si tu hosting no da DATABASE_URL): usar estas variables
# DB_HOST=tu-host-mysql
# DB_PORT=3306
# DB_USER=usuario
# DB_PASSWORD=contraseña
# DB_NAME=nombre_de_la_base

# --- Servidor ---
# En Railway/Render, PORT lo define la plataforma automaticamente.
# PORT=8080
# Poner en 1 cuando corre detras de Nginx o del proxy del hosting con HTTPS.
BEHIND_PROXY=1

# Clave secreta larga y aleatoria (genera una nueva, no uses la de desarrollo)
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# --- Correo de alertas (opcional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# --- OCR (opcional) ---
# En Linux suele ir vacio si tesseract esta en el PATH.
TESSERACT_CMD=

# --- Respaldos ---
MYSQLDUMP_PATH=
MAX_BACKUPS=30
